{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "server.py": {
      "maxDuration": 60,
      "memory": 1024,
      "excludeFiles": "{.venv/**,out/**,backend/tests/**,**/__pycache__/**,*.md,docs/**}"
    }
  },
  "env": {
    "AUDIO_DIR": "/tmp/out",
    "AUDIO_INLINE": "1"
  }
}
