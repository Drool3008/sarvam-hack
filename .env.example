# Model APIs (sarvamai SDK). Server-side only — never shipped to a client.
SARVAM_API_KEY=

# Force fixture responses even when a key is present (useful for demos/CI).
SARVAM_MOCK=false

# Confidence floor below which a model's output goes to a human to confirm.
CONFIDENCE_THRESHOLD=0.85

# Voice Agents platform (Indus) — needed only to place a real outbound phone
# call. Workspace API key, sent as X-API-Key. Rent the number in
# Indus -> Deploy -> Phone Numbers (Vobiz, after KYC).
SARVAM_VA_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_VA_BASE_URL=https://apps.sarvam.ai
